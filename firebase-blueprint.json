{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "users/{uid}/orders": {
      "title": "User Order",
      "description": "Order records for a user",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "status": { "type": "string" },
        "items": { "type": "array" },
        "customer": { "type": "object" },
        "shippingAddress": { "type": "object" },
        "prescriptionStatus": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "delivery": { "type": "number" },
        "total": { "type": "number" },
        "estimatedDelivery": { "type": "string" }
      },
      "required": ["orderId", "status", "total"]
    },
    "users/{uid}/wishlist": {
      "title": "User Wishlist Item",
      "description": "Wishlist items",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "addedAt": { "type": "string" },
        "selectedColor": { "type": "string" }
      },
      "required": ["productId"]
    },
    "users/{uid}/cart": {
      "title": "User Cart Item",
      "description": "Shopping cart items",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "color": { "type": "string" },
        "size": { "type": "string" },
        "lens": { "type": "string" },
        "quantity": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["productId", "quantity"]
    },
    "users/{uid}/savedItems": {
      "title": "Saved Item",
      "description": "Save for later items",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "savedAt": { "type": "string" }
      },
      "required": ["productId"]
    },
    "users/{uid}/addresses": {
      "title": "User Address",
      "description": "Saved shipping address",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "apartment": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "pinCode": { "type": "string" },
        "isDefault": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["fullName", "address", "city", "state", "pinCode"]
    },
    "users/{uid}/prescriptions": {
      "title": "User Prescription",
      "description": "Prescription records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "status": { "type": "string" },
        "fileName": { "type": "string" },
        "storagePath": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "users/{uid}/eyeTests": {
      "title": "User Eye Test",
      "description": "Eye test records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "bookingId": { "type": "string" },
        "resultSummary": { "type": "string" }
      },
      "required": ["id"]
    }
  }
}
